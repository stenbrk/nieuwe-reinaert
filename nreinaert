<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<title>Neon Merge</title>

<style>

body{
    margin:0;
    min-height:100vh;
    background:
        radial-gradient(circle at top,#2a0845,#120019 60%,#000);
    color:white;
    text-align:center;
    font-family:'Press Start 2P', cursive;
}

h1{
    margin-top:30px;
    color:#00ffff;
    text-shadow:
        0 0 10px #00ffff,
        0 0 20px #00ffff,
        0 0 40px #00ffff;
    font-size:32px;
}

p{
    color:#ff66ff;
    text-shadow:0 0 10px #ff66ff;
}

#board{
    position:relative;
    width:400px;
    height:400px;
    margin:30px auto;
    border-radius:20px;

    background:
        linear-gradient(
            135deg,
            rgba(255,0,255,.15),
            rgba(0,255,255,.15)
        );

    border:3px solid #00ffff;

    box-shadow:
        0 0 15px #00ffff,
        0 0 35px #00ffff,
        inset 0 0 20px rgba(255,255,255,.1);
}

#stats{
    display:flex;
    justify-content:center;
    gap:20px;
    margin:20px 0;
}

.box{
    min-width:140px;
    padding:15px;
    border-radius:12px;

    background:rgba(0,0,0,.4);

    border:2px solid #00ffff;

    box-shadow:
        0 0 10px #00ffff,
        inset 0 0 10px rgba(0,255,255,.2);
}

.box span{
    display:block;
    font-size:10px;
    color:#ff66ff;
    margin-bottom:10px;
}

#score,
#highscore{
    font-size:20px;
    color:#00ffff;
    text-shadow:
        0 0 10px #00ffff,
        0 0 20px #00ffff;
}

.bg{
    position:absolute;
    width:90px;
    height:90px;

    background:#1f1f3a;

    border:2px solid rgba(255,255,255,.08);

    border-radius:12px;
}

.tile{
    position:absolute;
    width:90px;
    height:90px;

    border-radius:12px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:18px;
    font-weight:bold;
    color:white;

    text-shadow:
        0 0 10px rgba(255,255,255,.9);

    box-shadow:
        0 0 15px currentColor;

    transition:
        left .18s ease,
        top .18s ease,
        transform .15s ease;
}

.pop{
    transform:scale(1.18);
}

</style>
</head>
<body>

<h1>Merge Numbers</h1>
<div id="stats">
    <div class="box">
        <span>SCORE</span>
        <div id="score">0</div>
    </div>

    <div class="box">
        <span>HIGH SCORE</span>
        <div id="highscore">0</div>
    </div>
</div>

<div id="board"></div>

<script>
const SIZE = 4;
const CELL = 98;

const boardEl = document.getElementById("board");


for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
        let bg = document.createElement("div");
        bg.className = "bg";
        bg.style.left = (8 + c * CELL) + "px";
        bg.style.top = (8 + r * CELL) + "px";
        boardEl.appendChild(bg);
    }
}

let nextId = 1;
let tiles = [];
let score = 0;


const colors = {
    1:"#666666",
    2:"#00e5ff",
    4:"#00ff88",
    8:"#ffee00",
    16:"#ff9800",
    32:"#ff3d00",
    64:"#ff00ff",
    128:"#9c27b0",
    256:"#00b0ff",
    512:"#00ffea",
    1024:"#76ff03",
    2048:"#ffd600",
    4096:"#ffffff"
};

function position(tile){
    tile.el.style.left = (8 + tile.c * CELL) + "px";
    tile.el.style.top = (8 + tile.r * CELL) + "px";
}

function spawn(){
    let empty = [];

    for(let r=0;r<SIZE;r++){
        for(let c=0;c<SIZE;c++){
            if(!tiles.find(t => t.r === r && t.c === c)){
                empty.push([r,c]);
            }
        }
    }

    if(!empty.length) return;

    const [r,c] = empty[Math.floor(Math.random()*empty.length)];

    const el = document.createElement("div");
    el.className = "tile pop";
    el.textContent = "1";
    el.style.background = colors[1];

    boardEl.appendChild(el);

    const tile = {
        id: nextId++,
        v: 1,
        r,
        c,
        el
    };

    position(tile);

    tiles.push(tile);

    setTimeout(()=>{
        el.classList.remove("pop");
    },100);
}

function compress(line){
    let merged = [];
    let filtered = line.filter(Boolean);
    let out = [];

    for(let i=0;i<filtered.length;i++){

        if(
            i < filtered.length - 1 &&
            filtered[i].v === filtered[i+1].v
        ){
            filtered[i].v *= 2;

            merged.push({
                keep: filtered[i],
                remove: filtered[i+1]
            });

            out.push(filtered[i]);
            i++;
        }
        else{
            out.push(filtered[i]);
        }
    }

    return {
        out,
        merged
    };
}

function move(dir){

    let moved = false;
    let mergedAll = [];

    if(dir === "L" || dir === "R"){

        for(let r=0;r<SIZE;r++){

            let row = [];

            for(let c=0;c<SIZE;c++){
                row.push(
                    tiles.find(t => t.r===r && t.c===c)
                );
            }

            if(dir==="R") row.reverse();

            const result = compress(row);

            mergedAll.push(...result.merged);

            while(result.out.length < SIZE){
                result.out.push(null);
            }

            if(dir==="R") result.out.reverse();

            result.out.forEach((tile,col)=>{
                if(tile){
                    if(tile.c !== col){
                        moved = true;
                        tile.c = col;
                    }
                }
            });
        }
    }

    if(dir === "U" || dir === "D"){

        for(let c=0;c<SIZE;c++){

            let col = [];

            for(let r=0;r<SIZE;r++){
                col.push(
                    tiles.find(t => t.r===r && t.c===c)
                );
            }

            if(dir==="D") col.reverse();

            const result = compress(col);

            mergedAll.push(...result.merged);

            while(result.out.length < SIZE){
                result.out.push(null);
            }

            if(dir==="D") result.out.reverse();

            result.out.forEach((tile,row)=>{
                if(tile){
                    if(tile.r !== row){
                        moved = true;
                        tile.r = row;
                    }
                }
            });
        }
    }

    tiles.forEach(position);

    setTimeout(()=>{

        mergedAll.forEach(m=>{

            m.keep.el.textContent = m.keep.v;
            m.keep.el.style.background =
                colors[m.keep.v] || "#fff";

            m.keep.el.classList.add("pop");

            setTimeout(()=>{
                m.keep.el.classList.remove("pop");
            },120);

            m.remove.el.remove();

            tiles = tiles.filter(
                t => t !== m.remove
            );
        });

        if(moved || mergedAll.length){
            spawn();
        }

    },190);
}

spawn();
spawn();

window.addEventListener("keydown",(e)=>{

    if(e.key==="ArrowLeft") move("L");
    if(e.key==="ArrowRight") move("R");
    if(e.key==="ArrowUp") move("U");
    if(e.key==="ArrowDown") move("D");

});
</script>

</body>
</html>
